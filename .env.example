
MERCADO_PAGO_ACCESS_TOKEN=

# Mercado Pago — Secret del webhook (Tus integraciones → Webhooks → "Clave secreta").
# Recomendado: con esto seteado se valida la firma y nadie puede falsear notificaciones.
MERCADO_PAGO_WEBHOOK_SECRET=

# Resend — API Key (re_xxxx)
RESEND_API_KEY=

# Email donde llegan las notificaciones de pedido.
# Con onboarding@resend.dev debe ser el email dueño de la cuenta Resend.
NOTIFICATION_EMAIL=

# URL pública del sitio (sin barra final), ej: https://tu-sitio.vercel.app
FRONTEND_URL=

# ── Supabase ────────────────────────────────────────────────────────────────
# Settings → API. Son claves públicas (la seguridad la da RLS).
# Estas se pegan en js/supabase-config.js (no se usan del lado server).
SUPABASE_URL=
SUPABASE_ANON_KEY=
